{
  "buildCommand": "pnpm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nexora-hrm-api.vercel.app/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://nexora-hrm-api.vercel.app/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
