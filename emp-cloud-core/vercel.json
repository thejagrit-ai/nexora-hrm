{
  "buildCommand": "pnpm run build",
  "outputDirectory": "packages/client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nexora-hrm-backend.onrender.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://nexora-hrm-backend.onrender.com/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
